# Copy to .env and fill in. .env is gitignored. Never commit keys.

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Pinned models. voyage-3.5 defaults to 1024 dimensions (also 256, 512, 2048).
ANTHROPIC_MODEL=claude-sonnet-4-6
VOYAGE_EMBED_MODEL=voyage-3.5
REM_EMBED_DIM=1024

# Sampling and decoding. Critic temperature 0 keeps scores as stable as the provider allows.
REM_TEMPERATURE=0.4
REM_CRITIC_TEMPERATURE=0.0
REM_SEED=0
REM_MAX_TOKENS=800

# semantic_bridge | analogical_transfer | dialectic_synthesis | all
REM_STRATEGY=semantic_bridge
REM_CANDIDATES_PER_RUN=5
REM_PAIR_CAP=8000

# Semantic-bridge pair band and greedy cluster link.
REM_MIN_SIM=0.05
REM_MAX_SIM=0.35
REM_CLUSTER_LINK=0.55

# Analogical-transfer band (different domain tags required).
REM_ANALOGICAL_MIN=0.15
REM_ANALOGICAL_MAX=0.55

# Dialectic band and the cosine the scorer treats as ideal tension.
REM_DIALECTIC_MIN=0.20
REM_DIALECTIC_MAX=0.75
REM_DIALECTIC_TARGET=0.45

# Novelty filter: drop hypotheses closer than the ceiling or farther than the floor.
REM_NOVELTY_CEILING=0.88
REM_INCOHERENCE_FLOOR=0.05

# Critic. Weights must sum to 1. Accept when composite >= threshold and every axis >= floor.
REM_CRITIC_THRESHOLD=0.60
REM_CRITIC_FLOOR=0.30
REM_WEIGHT_NOVELTY=0.30
REM_WEIGHT_COHERENCE=0.30
REM_WEIGHT_FALSIFIABILITY=0.20
REM_WEIGHT_UTILITY=0.20

REM_DB_PATH=./data/fragments.db
